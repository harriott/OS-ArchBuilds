pikn, prs  defined in  $AjB/bashrc-console

# build
## Arch install - from the ISO
SDCB32G2  with  ARCH_202610  in lh USB
### keyboard, internet, time
loadkeys fr
as in  $coAr/build/bs-iwctl/Jo-OPPO-A76.sh
timedatectl
### partitions
lsblk  shows  CV1-8B128-HP  is  /dev/sdb
  gdisk /dev/sdb > o (create a new empty GUID partition table GPT & new protective MBR) y
    w > y
  gdisk /dev/sdb  (MBR: protection  GPT: present)
    n > Partition number (defaults to 1) > First sector (defaults to 2048) > Last sector > +1g >
      ef00 (EFI system partition)
    n > Partition number (defaults to 2) > First sector (defaults to the sector after partition 2) >
      +4g > 8200 (Linux swap)
    n > Partition number (defaults to 3) > First sector (defaults to 250068991) > Hex code >
      8304 Linux x86-64 root (/)
    w > y
mkfs.fat -F32 /dev/sdb1
mkswap /dev/sdb2
lsblk -f
mkfs.ext4 /dev/sdb3
gdisk /dev/sda > o (create a new empty GUID partition table GPT & new protective MBR) y > w > y
gdisk /dev/sda  (MBR: protection  GPT: present) > n > all defaults > w > y
mkfs.ext4 -L HX256GSSDSATA3 /dev/sda1
### chroot
#### prepare drives
mount /dev/sdb3 /mnt
mount --mkdir /dev/sdb1 /mnt/efi - should've been /mnt/boot
swapon /dev/sdb2
swapon -s
#### basic system, into chroot
as in  $OSAB/bs-0-boot/0-into_chroot.sh
#### in chroot
ping 8.8.8.8
##### host, locale, needed packages, time
manually entered all but en_GB from  $OSAB/bs-0-boot/2-prepare_for_root-1.sh
##### passwd
pw > pw
#### (not /efi but) /boot
Ctrl+d (= exit)
umount /dev/sdb1  for  mount /dev/sdb1 /mnt/boot
##### back into chroot
genfstab -U /mnt >> /mnt/etc/fstab
cat /mnt/etc/fstab
arch-chroot -S /mnt
#### K16GBDTG2 for Dr-IT
mount /dev/sdd1 /efi  (abusing it)
##### get my needed repositories
source'd (from /efi) $OSAB/bs-0-boot/1-get_onGHs.sh
##### get fstab
cd /
cat /etc/fstab
pacman -S nano
nano /etc/fstab
cat /etc/fstab > /efi/HPEB840G37/fstab-qat
umount /dev/sdd1
from sbMb, prep'd  $ABno/efi_loader/entries_arch_conf/HPEB840G37.conf
