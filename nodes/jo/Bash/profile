# vim: set ft=sh sw=2:
#
# $AjB/profile
#  symlinked in  $ABno-set/jo-0-Bash.sh  to  ~/.bp_everywhere
#   which is then sourced from
#    $AjB/profile-KDE
#    $AjB/profile-X
#  supplements and overrides  /etc/profile

export loaded_bp=1

# exports defined here so they can be accessed pre-X, by
#  $ABjo/Openbox/openbox/autostart, & by gvim
# kill tmux sessions if you've made changes here
source ~/.start  # $ABnm/Bash_start
  source ~/.export-Arch  # $ABno/Bash/export-Arch
    source $OSL/nodes/jo/export
# - carry through to X

# For $ABno/Bash/jazz/bashrc:
export bj='/home/jo/Arch/bash_jazz'
# echo ble.sh > $bj
echo flyline > $bj

# Useful before X:
  source ~/.bashrc-generic  # ($ABno/Bash/bashrc-generic) useful everywhere, including root
  source ~/.bashrc-console  # ($AjB/bashrc-console) useful also in Console as user

# This is commented out because I keep bashrc just for instances in X:
#  [[ -f ~/.bashrc ]] && . ~/.bashrc

# backup the previous boot's systemd journal
if [[ $myDrA == 1 ]]; then
  jc="$ITAh/ml-$host/jc"
else
  jc=~/Arch
fi
journalctl -b -1 > $jc/$(date '+%y%m%d-%H%M').jctl &

