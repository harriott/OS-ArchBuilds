
# $ABjo/wm/TS/thunderbird_safely.desktop
#  symlinked in my  $OSAB/nodes-set/jo-3-when_myDrA.sh
#   to reveal my command  thunderbird_safely  to Desktop
#  desktop-file-validate /usr/share/applications/thunderbird_safely.desktop

[Desktop Entry]
Name=Thunderbird Safely
Comment=run Thunderbird safely from profile shared on Dropbox
Exec=/usr/local/bin/thunderbird_safely
Terminal=false
Type=Application
Icon=thunderbird
Categories=Network;Email;

