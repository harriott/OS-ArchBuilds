# vim: fdl=2 ft=sh sw=2:

# $ABno/Bash/ble-atuin
#  sourced at end of
#   $AjB/bashrc
#   $ABno/root/bashrc

#=> 0 ble.sh
# $ABno/Bash/blerc
[[ ! ${BLE_VERSION-} ]] || ble-attach

#=> 1 Atuin
# command history
if [ -f /usr/bin/atuin ]; then
  export ATUIN_NOBIND=1
  eval "$(atuin init bash)"
  bind -x '"\C-u": __atuin_history'
fi

